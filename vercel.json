{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/work",
      "destination": "/?utm_source=social&utm_medium=portfolio&utm_campaign=ehr_experience",
      "permanent": false
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/" }
  ]
}
